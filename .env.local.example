JWT_SECRET=change-this-to-a-long-random-string-in-production
NEXT_PUBLIC_APP_URL=http://localhost:3000
FOUNDER_EMAIL=founder@madebyindividual.com

# Optional — enables Redis for auth token blacklist + refresh store (multi-instance safe)
# Leave blank to use in-memory store (fine for local dev / single server)
REDIS_URL=redis://localhost:6379
# REDIS_URL=rediss://default:password@your-redis-host:6379

# Optional email
# RESEND_API_KEY=

# Stripe test mode
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_MCP_KEY=rk_test_...
