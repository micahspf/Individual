# PostgreSQL connection string (Neon, Supabase, Railway, etc.)
# Example Neon:
# DATABASE_URL="postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js / NextAuth — long random string
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# Stripe (test keys for local; live keys only on Vercel production)
# Never commit real values — put them in .env.local or Vercel env
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Optional restricted key for Stripe MCP tooling only (not used by the app)
STRIPE_MCP_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Individual"

# Business contact (public-facing — use domain mailbox, not a personal Gmail)
FOUNDER_EMAIL="madebyindividual@gmail.com"

# Email (optional)
RESEND_API_KEY=""
