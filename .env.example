# PostgreSQL connection string (Neon, Supabase, Railway, etc.)
# Example Neon:
# DATABASE_URL="postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js / NextAuth — long random string
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# Stripe (optional — demo checkout works without these)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Made by Individual"

# Business contact (public-facing — use domain mailbox, not a personal Gmail)
FOUNDER_EMAIL="founder@madebyindividual.com"

# Email (optional)
RESEND_API_KEY=""
